# ===========================================
# Configuración del Scraper de Videos
# ===========================================
# Copia este archivo a .env y ajusta los valores según tu sistema

# Ruta base donde se guardan los videos descargados
# Ejemplo Linux/macOS: VIDEOS_DIR=/home/usuario/VIDEOS
# Ejemplo Windows: VIDEOS_DIR=C:\Users\usuario\Videos
VIDEOS_DIR=/ruta/a/tu/carpeta/VIDEOS

# Puerto del servidor web
PORT=3000

# Nivel de logging: debug, info, warn, error
LOG_LEVEL=info

# Cookies para yt-dlp (opcional)
# 1) Archivo exportado en formato Netscape:
# COOKIES_FILE=./cookies.txt
# 2) O extraerlas directamente de un navegador instalado
#    (chrome, firefox, edge, brave, opera, vivaldi, safari):
# COOKIES_FROM_BROWSER=firefox
# 3) Script propio que regenere el archivo de cookies (opcional):
# COOKIES_REFRESH_SCRIPT=./export-cookies.sh

# Ruta al binario de Deno usado por yt-dlp para resolver retos de YouTube
# DENO_PATH=/ruta/a/.deno/bin/deno

# Configuración de scraping
MAX_SCROLLS=10
SCROLL_WAIT_MS=400
SCROLL_LOAD_WAIT_MS=1200
THUMBNAIL_MAX_ROUNDS=6
THUMBNAIL_WAIT_MS=600
IMAGE_LOAD_TIMEOUT_MS=3000

# Configuración de descargas
MAX_RETRIES=3
RETRY_DELAY_MS=2000
